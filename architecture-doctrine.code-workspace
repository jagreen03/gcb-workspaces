{
    "folders": [
        { "path": "../gcb-spec", "name": "gcb-spec" },
        { "path": "../gcb-wiki", "name": "gcb-wiki" },
        { "path": "../gcb-papers", "name": "gcb-papers" },
        { "path": "../gcb-grants", "name": "gcb-grants" },
        { "path": ".", "name": "gcb-workspaces" }
    ],
    "settings": {
        "files.exclude": {
            "**/.git": true,
            "**/__pycache__": true
        }
    },
    "extensions": {
        "recommendations": [
            "davidanson.vscode-markdownlint",
            "redhat.vscode-yaml",
            "yzhang.markdown-all-in-one"
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "PBG: Parse backlog telemetry -> pgvector (gcb-workspaces)",
                "type": "debugpy",
                "request": "launch",
                "program": "${workspaceFolder:gcb-workspaces}/scripts/parse_pbg_telemetry.py",
                "args": [
                    "--backlog",
                    "${workspaceFolder:gcb-workspaces}/backlog",
                    "--emit",
                    "jsonl"
                ],
                "console": "integratedTerminal",
                "cwd": "${workspaceFolder:gcb-workspaces}",
                "justMyCode": true
            },
            {
                "name": "SPEC: Debug regen.py --all (gcb-spec)",
                "type": "debugpy",
                "request": "launch",
                "program": "${workspaceFolder:gcb-spec}/regen.py",
                "args": [
                    "--all"
                ],
                "console": "integratedTerminal",
                "cwd": "${workspaceFolder:gcb-spec}"
            }
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "DOC: Markdown lint (gcb-spec + gcb-wiki)",
                "type": "shell",
                "command": "markdownlint",
                "args": [
                    "${workspaceFolder:gcb-spec}/**/*.md",
                    "${workspaceFolder:gcb-wiki}/**/*.md",
                    "--ignore",
                    "**/node_modules/**"
                ],
                "options": {
                    "cwd": "${workspaceFolder:gcb-workspaces}"
                },
                "group": {
                    "kind": "test",
                    "isDefault": true
                },
                "problemMatcher": {
                    "owner": "markdownlint",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^([^:]+):(\\d+)(?::(\\d+))?\\s+(MD\\d+\\S*)\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "code": 4,
                        "message": 5
                    }
                },
                "presentation": { "reveal": "always", "panel": "shared", "clear": true }
            },
            {
                "label": "PAPERS: Build PDFs (Preprint & Datasheet)",
                "type": "shell",
                "command": "./scripts/build_pdfs.sh",
                "options": {
                    "cwd": "${workspaceFolder:gcb-papers}"
                },
                "group": "build",
                "presentation": { "reveal": "always", "panel": "shared", "clear": true }
            }
        ]
    }
}
